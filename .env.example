# =============================================================================
# KAYA KALPA — Variables de entorno
# =============================================================================
# Copiar este archivo a `.env` en la raíz del proyecto y completar los valores.
#
#   cp .env.example .env
#
# El archivo `.env` está en .gitignore y NUNCA debe commitearse.
# Docker Compose y el servidor leen ambos este mismo archivo.
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL (consumido por docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=kaya
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=kaya_kalpa
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Origen permitido por CORS. En desarrollo, el dev server de Vite.
# En producción, el dominio real: https://kayakalpa.com.ar
CORS_ORIGIN=http://localhost:5173

# Poner en `true` SOLO si hay un proxy inverso (Nginx, Traefik, Vercel) adelante.
# Sin esto, el rate limiting ve la IP del proxy y bloquea a todos los clientes
# como si fueran uno solo.
TRUST_PROXY=false

LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# Base de datos (consumido por Prisma)
# -----------------------------------------------------------------------------
# Debe coincidir con las variables POSTGRES_* de arriba.
DATABASE_URL=postgresql://kaya:cambiar_esta_password@localhost:5432/kaya_kalpa?schema=public


# -----------------------------------------------------------------------------
# Autenticación del panel administrativo
# -----------------------------------------------------------------------------
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Usar valores DISTINTOS para cada uno.
JWT_ACCESS_SECRET=generar_un_secreto_largo_y_aleatorio_para_access
JWT_REFRESH_SECRET=generar_otro_secreto_distinto_para_refresh

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Credenciales del primer usuario ADMIN, usadas UNA sola vez por `npm run db:seed`.
# Cambiar la contraseña desde el panel después del primer ingreso.
ADMIN_EMAIL=admin@kayakalpa.com
ADMIN_PASSWORD=cambiar_esta_password_inicial
ADMIN_NAME=Administración


# -----------------------------------------------------------------------------
# Reglas del sistema de turnos
# -----------------------------------------------------------------------------
# Zona horaria de la estética. Argentina no aplica horario de verano.
TZ=America/Argentina/Cordoba
SALON_TIMEZONE=America/Argentina/Cordoba

# Cada cuántos minutos se ofrece un horario de inicio.
SLOT_GRANULARITY_MINUTES=15

# Anticipación mínima para reservar online.
MIN_LEAD_TIME_HOURS=2

# Anticipación máxima con la que se puede reservar.
MAX_ADVANCE_DAYS=60

# Minutos de limpieza entre un turno y el siguiente.
BUFFER_MINUTES=10


# -----------------------------------------------------------------------------
# Datos de contacto de la estética
# -----------------------------------------------------------------------------
# NO van acá. El nombre, la dirección, el teléfono, el WhatsApp y las redes se
# cargan en la tabla site_settings y se editan desde /admin -> Configuración,
# porque son datos que la estética cambia sin redeployar.
#
# Tenerlos también en el entorno creaba una segunda fuente de verdad: cambiar el
# número en el .env no habría cambiado nada en el sitio, y nadie entendería por
# qué. La fuente es la base; el panel es la forma de editarla.


# -----------------------------------------------------------------------------
# Cliente
# -----------------------------------------------------------------------------
# Casi no hay variables de entorno del cliente, y es deliberado: el frontend usa
# rutas relativas `/api` —el proxy de Vite en desarrollo, el mismo origen en
# producción— y así la cookie httpOnly del panel viaja sin CORS ni `sameSite=None`.
#
# Una variable `VITE_API_URL` la incrustaría Vite en el bundle y el navegador
# pasaría a saber dónde vive la API, que es justo lo que la ruta relativa evita.
# La única excepción es el prerenderizado, que corre en Node sin origen contra el
# cual resolver: ese proceso fija la base con `setApiBase()` y no lee de acá.

# La dirección pública del sitio, con protocolo y sin barra final.
#
# La usan las etiquetas que **tienen** que ser absolutas (§37): el `canonical` de
# cada página y el `og:image` de las fichas. Vite solo expone las variables que
# empiezan con `VITE_`, así que la contraseña de Postgres y los secretos de los
# tokens no salen de acá.
#
# Vacía a propósito: el dominio todavía no está definido y un `canonical` inventado
# es peor que no tener ninguno. Mientras esté vacía el sitio no emite esas
# etiquetas y no pasa nada. Ver CONFLICTOS.md, punto 13.
#
# VITE_SITE_URL=https://kayakalpa.com.ar
